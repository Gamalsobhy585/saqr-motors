
APP_NAME="SAQR Motors"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL - Laravel Sail
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=saqr_motors
DB_USERNAME=sail
DB_PASSWORD=password

FORWARD_DB_PORT=5434

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Cache, Queue and Session
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Filesystem
FILESYSTEM_DISK=public

# Broadcasting
BROADCAST_CONNECTION=log

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@saqr.test"
MAIL_FROM_NAME="${APP_NAME}"

# Sail
WWWUSER=1000
WWWGROUP=1000

# Vite
VITE_PORT=5173
VITE_APP_NAME="${APP_NAME}"

# SAQR Seeder Accounts
SAQR_ADMIN_EMAIL=admin@saqr.test
SAQR_ADMIN_PASSWORD=

SAQR_DATA_ENTRY_EMAIL=dataentry@saqr.test
SAQR_DATA_ENTRY_PASSWORD=

